    {
    "_version": "1.12.0",
    "sap.app": {
        "id": "com.poc.fiori",
        "type": "application",
        "title": "SAP Fiori POC",
        "description": "A simple Fiori MVC proof of concept",
        "applicationVersion": { "version": "1.0.0" }
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
        "desktop": true,
        "tablet": true,
        "phone": true
        }
    },
    "sap.ui5": {
        "rootView": {
        "viewName": "com.poc.fiori.view.Main",
        "type": "XML",
        "async": true,
        "id": "app"
        },
        "dependencies": {
        "minUI5Version": "1.76.0",
        "libs": {
            "sap.m": {},
            "sap.ui.core": {},
            "sap.f": {}
        }
        },
        "models": {
        "i18n": {
            "type": "sap.ui.model.resource.ResourceModel",
            "settings": {
            "bundleName": "com.poc.fiori.i18n.i18n"
            }
        }
        }
    }
    }